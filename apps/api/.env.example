PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
# Mỗi secret tối thiểu 32 ký tự
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Nhiều origin cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000
# IP hoặc CIDR của proxy đứng trước API, cách nhau bằng dấu phẩy. Chạy local để trống
TRUSTED_PROXIES=
# lax khi web và API cùng site, none khi khác site (cần HTTPS)
REFRESH_COOKIE_SAME_SITE=lax
# Ví dụ .tenmien.vn. Chạy local để trống
REFRESH_COOKIE_DOMAIN=
# Client ID loại Web application. Để trống thì tắt đăng nhập Google
GOOGLE_CLIENT_ID=
# Gửi thư quên mật khẩu qua Brevo. Để trống thì chỉ ghi log, xem docs/08-deploy.md
BREVO_API_KEY=
EMAIL_FROM=
# Khoá cho job nhắc học hằng ngày (GitHub Actions), để trống thì tắt. openssl rand -hex 32
JOBS_SECRET=
# Web Push, tạo bằng: npx web-push generate-vapid-keys. Để trống thì tắt thông báo đẩy.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Địa chỉ web trong liên kết của thư, để trống thì lấy origin đầu tiên của CORS_ORIGINS
WEB_ORIGIN=
# Upstash Redis REST cho rate limit dùng chung. Để trống thì đếm trong bộ nhớ, xem docs/08-deploy.md
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cloudflare R2 cho ảnh của thẻ. Để trống thì tắt tải ảnh, xem docs/08-deploy.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Tìm kiếm ảnh trực tuyến cho thẻ học (Unsplash / Pixabay). Để trống nếu không dùng
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
# fatal, error, warn, info, debug, trace hoặc silent
LOG_LEVEL=info
# Neon: chuỗi không pooling cho migration. Local để trống thì dùng DATABASE_URL
DIRECT_URL=
# Số request mỗi phút cho một người dùng và một IP chưa đăng nhập
RATE_LIMIT_USER_PER_MINUTE=100
RATE_LIMIT_GUEST_PER_MINUTE=300
# Số lần đăng ký mỗi phút cho một IP
RATE_LIMIT_REGISTER_PER_MINUTE=3
# Số lần làm mới phiên mỗi phút cho một IP
RATE_LIMIT_REFRESH_PER_MINUTE=60
