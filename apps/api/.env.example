PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
# Mỗi secret tối thiểu 32 ký tự
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Nhiều origin cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000
# IP hoặc CIDR của proxy đứng trước API, cách nhau bằng dấu phẩy. Chạy local để trống
TRUSTED_PROXIES=
# lax khi web và API cùng site, none khi khác site (cần HTTPS)
REFRESH_COOKIE_SAME_SITE=lax
# Ví dụ .tenmien.vn. Chạy local để trống
REFRESH_COOKIE_DOMAIN=
# Client ID loại Web application. Để trống thì tắt đăng nhập Google
GOOGLE_CLIENT_ID=
# fatal, error, warn, info, debug, trace hoặc silent
LOG_LEVEL=info
# Neon: chuỗi không pooling cho migration. Local để trống thì dùng DATABASE_URL
DIRECT_URL=
# Số request mỗi phút cho một người dùng và một IP chưa đăng nhập
RATE_LIMIT_USER_PER_MINUTE=100
RATE_LIMIT_GUEST_PER_MINUTE=300
