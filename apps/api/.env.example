PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
# Mỗi secret tối thiểu 32 ký tự
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Nhiều origin cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000
# IP hoặc CIDR của proxy đứng trước API, cách nhau bằng dấu phẩy. Chạy local để trống
TRUSTED_PROXIES=
