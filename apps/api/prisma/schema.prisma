generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Visibility {
  PRIVATE
  CLASS
  PUBLIC
}

enum StudyMode {
  FLASHCARD
  LEARN
  WRITE
  DICTATION
  CLOZE
  MCQ
  MATCH
  TEST
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  googleId     String?   @unique
  displayName  String
  role         Role      @default(STUDENT)
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  /// ADMIN khoá tài khoản: không đăng nhập, không gọi API được cho tới khi mở khoá.
  lockedAt     DateTime?
  lockReason   String?
  lockedById   String?

  refreshSessions RefreshSession[]
  folders         Folder[]
  studySets       StudySet[]
  cardProgress    CardProgress[]
  studySessions   StudySession[]
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Folder {
  id      String @id @default(cuid())
  ownerId String
  name    String

  owner User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sets  StudySet[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model StudySet {
  id          String     @id @default(cuid())
  ownerId     String
  folderId    String?
  title       String
  description String?
  termLang    String     @default("en")
  defLang     String     @default("vi")
  visibility  Visibility @default(PRIVATE)
  cardCount   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folder        Folder?        @relation(fields: [folderId], references: [id])
  cards         Card[]
  studySessions StudySession[]

  @@index([ownerId, updatedAt])
  @@index([visibility])
}

model Card {
  id         String   @id @default(cuid())
  setId      String
  position   Int
  term       String
  definition String
  phonetic   String?
  example    String?
  imageUrl   String?
  audioUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  set      StudySet       @relation(fields: [setId], references: [id], onDelete: Cascade)
  progress CardProgress[]
  attempts Attempt[]

  @@index([setId, position])
}

model CardProgress {
  userId     String
  cardId     String
  ease       Float    @default(2.5)
  interval   Int      @default(0)
  reps       Int      @default(0)
  lapses     Int      @default(0)
  dueAt      DateTime @default(now())
  lastResult Boolean?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
  @@index([userId, dueAt])
}

model StudySession {
  id         String    @id @default(cuid())
  userId     String
  setId      String
  mode       StudyMode
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  correct    Int       @default(0)
  total      Int       @default(0)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  set      StudySet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([userId, startedAt])
}

model Attempt {
  id        String   @id @default(cuid())
  sessionId String
  cardId    String
  answer    String
  isCorrect Boolean
  timeMs    Int
  createdAt DateTime @default(now())

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  card    Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}
