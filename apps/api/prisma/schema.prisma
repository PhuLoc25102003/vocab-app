generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Visibility {
  PRIVATE
  CLASS
  PUBLIC
}

enum StudyMode {
  FLASHCARD
  LEARN
  WRITE
  DICTATION
  CLOZE
  MCQ
  MATCH
  TEST
  SPEAK
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  googleId     String?   @unique
  displayName  String
  role         Role      @default(STUDENT)
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  /// ADMIN khoá tài khoản: không đăng nhập, không gọi API được cho tới khi mở khoá.
  lockedAt     DateTime?
  lockReason   String?
  lockedById   String?
  /// Mục tiêu XP mỗi ngày người học chọn: 10, 20 hoặc 50.
  dailyGoalXp  Int       @default(20)

  refreshSessions     RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  folders             Folder[]
  studySets           StudySet[]
  cardProgress        CardProgress[]
  studySessions       StudySession[]
  teachingClasses     Class[]
  classMembers        ClassMember[]
  submissions         AssignmentSubmission[]
  xpEvents            XpEvent[]
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Liên kết đặt lại mật khẩu. Chỉ lưu SHA-256 của token, dùng một lần, hết hạn sau 30 phút.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Folder {
  id      String @id @default(cuid())
  ownerId String
  name    String

  owner User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sets  StudySet[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model StudySet {
  id           String     @id @default(cuid())
  ownerId      String
  folderId     String?
  title        String
  description  String?
  termLang     String     @default("en")
  defLang      String     @default("vi")
  visibility   Visibility @default(PRIVATE)
  cardCount    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  /// ADMIN ẩn bộ vi phạm: người khác không thấy, chủ bộ và ADMIN vẫn thấy.
  hiddenAt     DateTime?
  hiddenReason String?
  hiddenById   String?

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folder        Folder?        @relation(fields: [folderId], references: [id])
  cards         Card[]
  studySessions StudySession[]
  assignments   Assignment[]

  @@index([ownerId, updatedAt])
  @@index([visibility])
}

model Card {
  id         String   @id @default(cuid())
  setId      String
  position   Int
  term       String
  definition String
  phonetic   String?
  example    String?
  imageUrl   String?
  audioUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  set      StudySet       @relation(fields: [setId], references: [id], onDelete: Cascade)
  progress CardProgress[]
  attempts Attempt[]

  @@index([setId, position])
}

model CardProgress {
  userId     String
  cardId     String
  ease       Float    @default(2.5)
  interval   Int      @default(0)
  reps       Int      @default(0)
  lapses     Int      @default(0)
  dueAt      DateTime @default(now())
  lastResult Boolean?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
  @@index([userId, dueAt])
}

model StudySession {
  id         String    @id @default(cuid())
  userId     String
  setId      String
  mode       StudyMode
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  correct    Int       @default(0)
  total      Int       @default(0)
  /// Phiên học làm cho một bài giao; xoá bài giao thì phiên vẫn còn, chỉ bỏ liên kết.
  assignmentId String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  set        StudySet    @relation(fields: [setId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  attempts   Attempt[]
  xpEvents   XpEvent[]

  @@index([userId, startedAt])
  @@index([assignmentId, userId])
}

enum XpSource {
  ANSWERS
}

/// Mỗi lần được cộng XP, ví dụ một lô đáp án đã chấm. Tổng, XP ngày và XP tuần đều cộng từ bảng này.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  source    XpSource @default(ANSWERS)
  /// Xoá phiên học thì XP vẫn còn, chỉ bỏ liên kết.
  sessionId String?
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session StudySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([sessionId])
}

model Attempt {
  id        String   @id @default(cuid())
  sessionId String
  cardId    String
  answer    String
  isCorrect Boolean
  timeMs    Int
  createdAt DateTime @default(now())

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  card    Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

/// Lớp do một giáo viên quản lý. Học sinh tham gia bằng `joinCode`, giáo viên đổi được mã.
model Class {
  id          String    @id @default(cuid())
  teacherId   String
  name        String
  description String?
  joinCode    String    @unique
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  teacher     User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  members     ClassMember[]
  assignments Assignment[]

  @@index([teacherId])
}

model ClassMember {
  classId  String
  userId   String
  joinedAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@index([userId])
}

/// Bộ từ giao cho cả lớp với một chế độ học. `dueAt` null là không có hạn nộp.
model Assignment {
  id        String    @id @default(cuid())
  classId   String
  setId     String
  mode      StudyMode
  /// Các chế độ phải làm, theo thứ tự. Thay cho `mode` (giữ lại đến lần deploy sau rồi mới xoá).
  modes     StudyMode[] @default([])
  dueAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  class       Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  set         StudySet               @relation(fields: [setId], references: [id], onDelete: Cascade)
  sessions    StudySession[]
  submissions AssignmentSubmission[]

  @@index([classId, dueAt])
  @@index([setId])
}

/// Bài nộp của một học sinh cho một bài giao. Nộp một lần; điểm (phần trăm) chốt lúc nộp, null khi
/// bài chỉ có chế độ không chấm điểm. `late`: nộp sau `dueAt`.
model AssignmentSubmission {
  assignmentId String
  userId       String
  submittedAt  DateTime @default(now())
  score        Int?
  late         Boolean  @default(false)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([assignmentId, userId])
  @@index([userId])
}
